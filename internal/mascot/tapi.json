{
  "name": "tapi",
  "shape": "round",
  "light": "glint",
  "palette": {"hi": "#f8ecd9", "bd": "#e4c49a", "sh": "#c7a57c", "eye": "#2b201c"},
  "sprites": {
    "pearl3": [
      [["🬞","bd",null],["🬹","hi",null],["🬹","bd",null],["🬹","bd",null],["🬏","bd",null]],
      [["█","bd",null],["$0","eye","bd"],["$1","eye","bd"],["$2","eye","bd"],["█","sh",null]],
      [["🬁","sh",null],["🬎","sh",null],["🬎","sh",null],["🬎","sh",null],["🬀","sh",null]]
    ],
    "pearl1": [
      [["▐","bd",null],["$0","eye","bd"],["$1","eye","bd"],["$2","eye","bd"],["▌","sh",null]]
    ]
  },
  "states": {
    "idle":  {"eyes": "• •", "cell": "•", "accent": "i"},
    "work":  {"eyes": "● ●", "cell": "●", "accent": "w"},
    "wait":  {"eyes": "◕ ◕", "cell": "◉", "accent": "q"},
    "done":  {"eyes": "^ ^", "cell": "●", "accent": "d"},
    "error": {"eyes": "⨯ ⨯", "cell": "⨯", "accent": "x"},
    "sleep": {"eyes": "- -", "cell": "◦", "accent": "i"}
  },
  "reactions": {
    "merged":            {"eyes": "✦ ✦", "ascii": "* *", "accent": "d", "lines": ["{name} #{pr} merged", "{name} #{pr} is in, congrats", "{name} #{pr} merged, nice work"]},
    "ci_failed":         {"eyes": "╥ ╥", "ascii": "T T", "accent": "x", "lines": ["{name} #{pr} CI fell over", "{name} #{pr} failing checks: {fail}", "{name} #{pr} CI didn't make it"]},
    "changes_requested": {"eyes": "> <", "ascii": "> <", "accent": "q", "lines": ["{name} #{pr} got change requests", "{name} #{pr} they want some fixes", "{name} #{pr} changes requested"]},
    "new_comment":       {"eyes": "◒ ◒", "ascii": "o.o", "accent": "q", "lines": ["{name} #{pr} has new comments", "{name} #{pr} unresolved: {unresolved}", "{name} #{pr} someone said something"]},
    "approved":          {"eyes": "◠ ◠", "ascii": "^.^", "accent": "d", "lines": ["{name} #{pr} got approved", "{name} #{pr} approved, feels good", "{name} #{pr} passed review"]},
    "ci_passed":         {"eyes": "^ ^", "ascii": "^ ^", "accent": "d", "lines": ["{name} #{pr} CI passed", "{name} #{pr} all green", "{name} #{pr} every check passed"]},
    "ci_running":        {"eyes": "◔ ◔", "alt": "◓ ◓", "ascii": ". .", "ascii_alt": "o o", "accent": "i", "lines": ["{name} #{pr} watching CI", "{name} #{pr} checks are running", "{name} #{pr} CI, fingers crossed"]}
  }
}
